    "@eslint/js": "^9.20.0",
    "@shopware-ag/meteor-icon-kit": "workspace:^",
    "@shopware-ag/meteor-tokens": "workspace:^",
    "@shopware-ag/stylelint-plugin-meteor": "workspace:*",
    "@size-limit/file": "^14.3.0",
