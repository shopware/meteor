    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/vue-3": "^2.27.3",
    "@vuepic/vue-datepicker": "^12.1.0",
    "@vueuse/core": "^14.1.0",
    "@vueuse/shared": "^14.1.0",
    "apexcharts": "^5.2.0",
    "date-fns": "^4.1.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.17",
