{
  "name": "@shopware-ag/meteor-component-library",
  "version": "5.10.0",
  "description": "Vue 3 components of the Meteor Design System by Shopware.",
  "license": "MIT",
  "author": "shopware AG",
  "homepage": "https://meteor.shopware.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopware/meteor.git",
    "directory": "packages/component-library"
  },
  "bugs": "https://github.com/shopware/meteor/issues",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./font.css": "./dist/font.css",
    "./package.json": "./package.json",
    "./fonts/*": "./dist/fonts/*",
    "./*": {
      "types": "./dist/exports/*.d.mts",
      "default": "./dist/exports/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/exports/*.d.mts",
        "./*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "run-p lint:types \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "lint:types": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint:package": "publint --strict && node build/check-types.js",
    "lint:all": "npm run lint:eslint && npm run format:check && npm run lint:css",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{vue,css}\"",
    "lint:css:fix": "stylelint \"src/**/*.{vue,css}\" --fix",
    "format:check": "prettier . --check",
    "format": "prettier --write .",
    "dev": "npm run storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "test:storybook": "test-storybook"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@floating-ui/dom": "^1.7.0",
